{
  "name": "livepad",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:web": "tsx server.ts",
    "dev:electron": "vite build && electron electron/main.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:web": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:pwa": "vite build",
    "build:electron": "vite build && esbuild electron/main.ts --bundle --platform=node --format=esm --packages=external --outfile=electron/main.js && esbuild electron/preload.ts --bundle --platform=node --format=cjs --packages=external --outfile=electron/preload.js",
    "dist": "electron-builder",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js electron/*.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "node scripts/test-rules.mjs",
    "check:architecture": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/extension-bubble-menu": "^3.29.2",
    "@tiptap/extension-color": "^3.29.1",
    "@tiptap/extension-font-family": "^3.29.1",
    "@tiptap/extension-highlight": "^3.29.1",
    "@tiptap/extension-image": "^3.29.1",
    "@tiptap/extension-link": "^3.29.1",
    "@tiptap/extension-subscript": "^3.29.1",
    "@tiptap/extension-superscript": "^3.29.1",
    "@tiptap/extension-table": "^3.29.1",
    "@tiptap/extension-table-cell": "^3.29.1",
    "@tiptap/extension-table-header": "^3.29.1",
    "@tiptap/extension-table-row": "^3.29.1",
    "@tiptap/extension-task-item": "^3.29.1",
    "@tiptap/extension-task-list": "^3.29.1",
    "@tiptap/extension-text-align": "^3.29.1",
    "@tiptap/extension-text-style": "^3.29.1",
    "@tiptap/extension-underline": "^3.29.1",
    "@tiptap/react": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "@vitejs/plugin-react": "^5.0.4",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.14.0",
    "html-to-pdfmake": "^2.5.33",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfmake": "^0.3.11",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "firebase-admin": "^13.5.0",
    "monaco-editor": "0.56.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "@types/pdfmake": "^0.3.3",
    "autoprefixer": "^10.4.21",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.11",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@vitest/coverage-v8": "4.1.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
