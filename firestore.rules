rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // LivePad Foundation Security Policy (Phase 1)
    // -------------------------------------------------------------------------
    // Design goals:
    // 1. Authentication is mandatory for cloud access.
    // 2. A room code is an identifier, never an authorization secret.
    // 3. Membership/role is checked on the server (Firestore Rules).
    // 4. Security-sensitive fields cannot be changed by normal members.
    // 5. High-frequency presence is limited to the caller's own entry.
    // 6. Client deletion of workspaces/history/audit records is blocked.
    // 7. Collection enumeration is intentionally disabled.

    match /{document=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function validId(value) {
      return value is string && value.size() >= 1 && value.size() <= 256;
    }

    function validRoomId(roomId) {
      return roomId is string
        && roomId.size() >= 4
        && roomId.size() <= 16
        && roomId.matches('^[A-Za-z0-9_-]+$');
    }

    function roomRef(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId));
    }

    function roomExists(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId));
    }

    function isMemberByRoomId(roomId) {
      return signedIn()
        && roomExists(roomId)
        && roomRef(roomId).data.keys().hasAny(['participants'])
        && roomRef(roomId).data.participants is map
        && roomRef(roomId).data.participants.keys().hasAll([request.auth.uid]);
    }

    function isMemberData(data) {
      return signedIn()
        && data.keys().hasAny(['participants'])
        && data.participants is map
        && data.participants.keys().hasAll([request.auth.uid]);
    }

    function isOwnerByRoomId(roomId) {
      return signedIn()
        && roomExists(roomId)
        && roomRef(roomId).data.keys().hasAny(['ownerId'])
        && roomRef(roomId).data.ownerId == request.auth.uid;
    }

    function isOwnerData(data) {
      return signedIn() && data.keys().hasAny(['ownerId']) && data.ownerId == request.auth.uid;
    }

    function isAdminByRoomId(roomId) {
      return signedIn() && roomExists(roomId) && (
        roomRef(roomId).data.ownerId == request.auth.uid ||
        (roomRef(roomId).data.participants is map
          && roomRef(roomId).data.participants.keys().hasAll([request.auth.uid])
          && roomRef(roomId).data.participants[request.auth.uid].role == 'admin')
      );
    }

    function isAdminData(data) {
      return signedIn() && (
        (data.keys().hasAny(['ownerId']) && data.ownerId == request.auth.uid) ||
        (data.keys().hasAny(['participants'])
          && data.participants is map
          && data.participants.keys().hasAll([request.auth.uid])
          && data.participants[request.auth.uid].role == 'admin')
      );
    }

    function canEditData(data) {
      return signedIn()
        && data.keys().hasAny(['participants'])
        && data.participants is map
        && data.participants.keys().hasAll([request.auth.uid])
        && data.participants[request.auth.uid].role in [
          'owner', 'admin', 'editor', 'collaborator', 'teacher',
          'instructor', 'member', 'developer', 'student'
        ];
    }

    function canCommentData(data) {
      return signedIn()
        && data.keys().hasAny(['participants'])
        && data.participants is map
        && data.participants.keys().hasAll([request.auth.uid])
        && data.participants[request.auth.uid].role in [
          'owner', 'admin', 'editor', 'collaborator', 'teacher',
          'instructor', 'member', 'developer', 'student', 'commenter', 'reviewer'
        ];
    }

    function ownershipFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'creatorId', 'creatorRole']);
    }

    function validOwnerTransfer() {
      return isOwnerData(resource.data)
        && request.resource.data.ownerId is string
        && request.resource.data.creatorId == request.resource.data.ownerId
        && request.resource.data.creatorRole == 'owner'
        && request.resource.data.participants is map
        && request.resource.data.participants.keys().hasAll([request.resource.data.ownerId])
        && request.resource.data.participants[request.resource.data.ownerId].role == 'owner'
        && request.resource.data.participants.keys().hasAll([request.auth.uid])
        && request.resource.data.participants[request.auth.uid].role == 'admin'
        && request.resource.data.ownerId != request.auth.uid;
    }

    function canEditByRoomId(roomId) {
      return signedIn() && roomExists(roomId) && canEditData(roomRef(roomId).data);
    }

    function canCommentByRoomId(roomId) {
      return signedIn() && roomExists(roomId) && canCommentData(roomRef(roomId).data);
    }

    function validRoom(data) {
      return data.keys().hasAll(['content', 'createdAt', 'updatedAt'])
        && data.content is string
        && data.content.size() <= 262144
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(['roomCode']) || (data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 16))
        && (!data.keys().hasAny(['workspaceId']) || (data.workspaceId is string && data.workspaceId.size() <= 64))
        && (!data.keys().hasAny(['workspaceName']) || (data.workspaceName is string && data.workspaceName.size() <= 256))
        && (!data.keys().hasAny(['title']) || (data.title is string && data.title.size() <= 256))
        && (!data.keys().hasAny(['label']) || (data.label is string && data.label.size() <= 256))
        && (!data.keys().hasAny(['creatorId']) || (data.creatorId is string && data.creatorId.size() <= 128))
        && (!data.keys().hasAny(['createdBy']) || (data.createdBy is string && data.createdBy.size() <= 128))
        && (!data.keys().hasAny(['ownerId']) || (data.ownerId is string && data.ownerId.size() <= 128))
        && (!data.keys().hasAny(['ownerName']) || (data.ownerName is string && data.ownerName.size() <= 128))
        && (!data.keys().hasAny(['creatorRole']) || (data.creatorRole is string && data.creatorRole.size() <= 64))
        && (!data.keys().hasAny(['workspaceRoleVersion']) || data.workspaceRoleVersion is number)
        && (!data.keys().hasAny(['privacy']) || (data.privacy is string && data.privacy in ['public', 'private', 'invite-only']))
        && (!data.keys().hasAny(['participantLimit']) || (data.participantLimit is number && data.participantLimit >= 1 && data.participantLimit <= 1000))
        && (!data.keys().hasAny(['status']) || (data.status is string && data.status in ['active', 'archived', 'expired', 'deleted']))
        && (!data.keys().hasAny(['participants']) || data.participants is map)
        && (!data.keys().hasAny(['users']) || data.users is map)
        && (!data.keys().hasAny(['typingUsers']) || data.typingUsers is map)
        && (!data.keys().hasAny(['permissions']) || data.permissions is map)
        && (!data.keys().hasAny(['expiresAt']) || data.expiresAt == null || data.expiresAt is number)
        && (!data.keys().hasAny(['editingPolicy']) || (data.editingPolicy is string && data.editingPolicy.size() <= 64))
        && (!data.keys().hasAny(['codeExecutionEnabled']) || data.codeExecutionEnabled is bool)
        && (!data.keys().hasAny(['voiceChatEnabled']) || data.voiceChatEnabled is bool)
        && (!data.keys().hasAny(['chatEnabled']) || data.chatEnabled is bool)
        && (!data.keys().hasAny(['defaultRole']) || (data.defaultRole is string && data.defaultRole.size() <= 64))
        && (!data.keys().hasAny(['attachments']) || (data.attachments is list && data.attachments.size() <= 100));
    }

    function validRoomUpdate(existingData, incomingData) {
      let changed = incomingData.diff(existingData).affectedKeys();
      return incomingData.keys().hasAll(['content', 'createdAt', 'updatedAt'])
        && incomingData.content is string
        && incomingData.content.size() <= 262144
        && incomingData.createdAt is timestamp
        && incomingData.updatedAt is timestamp
        && (!changed.hasAny(['title']) || (incomingData.title is string && incomingData.title.size() <= 256))
        && (!changed.hasAny(['label']) || (incomingData.label is string && incomingData.label.size() <= 256))
        && (!changed.hasAny(['attachments']) || (incomingData.attachments is list && incomingData.attachments.size() <= 100))
        && (!changed.hasAny(['users']) || incomingData.users is map)
        && (!changed.hasAny(['typingUsers']) || incomingData.typingUsers is map)
        && (!changed.hasAny(['participants']) || incomingData.participants is map)
        && (!changed.hasAny(['updatedAt']) || incomingData.updatedAt is timestamp);
    }

    function selfPresenceOnly(existingData, incomingData) {
      let changed = incomingData.diff(existingData).affectedKeys();
      return changed.hasOnly(['users', 'typingUsers', 'participants'])
        && (!changed.hasAny(['users']) || (
          existingData.users is map
          && incomingData.users is map
          && incomingData.users.diff(existingData.users).affectedKeys().hasOnly([request.auth.uid])
        ))
        && (!changed.hasAny(['typingUsers']) || (
          existingData.typingUsers is map
          && incomingData.typingUsers is map
          && incomingData.typingUsers.diff(existingData.typingUsers).affectedKeys().hasOnly([request.auth.uid])
        ))
        && (!changed.hasAny(['participants']) || (
          existingData.participants is map
          && incomingData.participants is map
          && incomingData.participants.diff(existingData.participants).affectedKeys().hasOnly([request.auth.uid])
          && incomingData.participants[request.auth.uid].role == existingData.participants[request.auth.uid].role
        ));
    }

    function isPublicSelfJoin() {
      return signedIn()
        && resource.data.privacy == 'public'
        && resource.data.participants is map
        && !resource.data.participants.keys().hasAll([request.auth.uid])
        && request.resource.data.participants is map
        && request.resource.data.participants.diff(resource.data.participants).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.participants[request.auth.uid].uid == request.auth.uid
        && request.resource.data.participants[request.auth.uid].role == (
          resource.data.keys().hasAny(['defaultRole']) ? resource.data.defaultRole : 'member'
        )
        && (
          !request.resource.data.keys().hasAny(['users'])
          || (
            request.resource.data.users is map
            && (!resource.data.keys().hasAny(['users'])
              || request.resource.data.users.diff(resource.data.users).affectedKeys().hasOnly([request.auth.uid]))
          )
        );
    }

    function validHistory(data) {
      return data.keys().hasAll(['content', 'updatedAt', 'authorName'])
        && data.keys().hasOnly(['content', 'updatedAt', 'authorName', 'authorUid'])
        && data.content is string
        && data.content.size() <= 1048576
        && data.updatedAt is timestamp
        && data.authorName is string
        && data.authorName.size() <= 128
        && (!data.keys().hasAny(['authorUid']) || data.authorUid == request.auth.uid);
    }

    // ------------------------------- Rooms ----------------------------------
    match /rooms/{roomId} {
      // Direct reads only. No collection enumeration.
      allow get: if signedIn() && (
        (resource.data.keys().hasAny(['privacy']) && resource.data.privacy == 'public') ||
        isMemberData(resource.data)
      );
      allow list: if false;

      // A room can only be created by its authenticated owner.
      allow create: if signedIn()
        && validRoom(request.resource.data)
        && request.resource.data.roomCode == roomId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.creatorRole == 'owner'
        && request.resource.data.participants is map
        && request.resource.data.participants.keys().hasAll([request.auth.uid])
        && request.resource.data.participants[request.auth.uid].role == 'owner'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Normal members can edit content/title/label and their own presence.
      // Keep ordinary edits before specialized join/transfer branches so they can
      // short-circuit without evaluating unrelated authorization paths.
      allow update: if signedIn()
        && request.resource.data.createdAt == resource.data.createdAt
        && canEditData(resource.data)
        && validRoomUpdate(resource.data, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'content', 'updatedAt', 'title', 'label', 'attachments',
          'users', 'typingUsers', 'participants', 'lastClientId', 'lastTxId'
        ])
        && (
          selfPresenceOnly(resource.data, request.resource.data)
          || (
            request.resource.data.updatedAt == request.time
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['users', 'typingUsers', 'participants'])
          )
        );

      // Public rooms allow a caller to add only their own participant entry.
      allow update: if isPublicSelfJoin();

      // Owners/admins manage lifecycle and workspace settings.
      allow update: if signedIn()
        && request.resource.data.createdAt == resource.data.createdAt
        && isAdminData(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt', 'privacy', 'status', 'participantLimit', 'permissions',
          'editingPolicy', 'codeExecutionEnabled', 'voiceChatEnabled',
          'chatEnabled', 'defaultRole', 'expiresAt', 'workspaceName', 'title', 'label',
          'attachments', 'ownerName', 'workspaceRoleVersion'
        ])
        && !ownershipFieldsChanged()
        && request.resource.data.updatedAt == request.time;

      // Ownership transfer is a separate, tightly constrained operation.
      allow update: if signedIn()
        && validOwnerTransfer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt', 'ownerId', 'creatorId', 'creatorRole', 'participants', 'users'
        ])
        && request.resource.data.updatedAt == request.time;

      // Workspace deletion is intentionally a soft-delete operation.
      allow delete: if false;

      match /audit_logs/{logId} {
        allow get: if isMemberByRoomId(roomId);
        allow list: if isAdminByRoomId(roomId);
        allow create: if isAdminByRoomId(roomId)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.action is string
          && request.resource.data.action.size() <= 128;
        allow update, delete: if false;
      }

      match /history/{historyId} {
        allow get: if isMemberByRoomId(roomId);
        allow list: if isMemberByRoomId(roomId);
        allow create: if signedIn()
          && roomExists(roomId)
          && roomRef(roomId).data.participants is map
          && roomRef(roomId).data.participants.keys().hasAll([request.auth.uid])
          && roomRef(roomId).data.participants[request.auth.uid].role in [
            'owner', 'admin', 'editor', 'collaborator', 'teacher', 'instructor', 'member', 'developer', 'student'
          ]
          && validHistory(request.resource.data)
          && request.resource.data.updatedAt == request.time;
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow get: if isMemberByRoomId(roomId);
        allow list: if isMemberByRoomId(roomId);
        allow create: if canCommentByRoomId(roomId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 20000
          && request.resource.data.timestamp is number;
        allow update: if canCommentByRoomId(roomId) && (
          (resource.data.senderUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'editedAt']))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.reactions is map)
        );
        allow delete: if resource.data.senderUid == request.auth.uid || isAdminByRoomId(roomId);
      }

      match /projects/{projectId} {
        allow get: if isMemberByRoomId(roomId);
        allow list: if isMemberByRoomId(roomId);
        allow create, update: if canEditByRoomId(roomId);
        allow delete: if isAdminByRoomId(roomId);

        match /folders/{folderId} {
          allow get: if isMemberByRoomId(roomId);
          allow list: if isMemberByRoomId(roomId);
          allow create, update: if canEditByRoomId(roomId);
          allow delete: if canEditByRoomId(roomId);
        }

        match /files/{fileId} {
          allow get: if isMemberByRoomId(roomId);
          allow list: if isMemberByRoomId(roomId);
          allow create, update: if canEditByRoomId(roomId)
            && request.resource.data.content is string
            && request.resource.data.content.size() <= 1048576;
          allow delete: if canEditByRoomId(roomId);

          match /versions/{versionId} {
            allow get: if isMemberByRoomId(roomId);
            allow list: if isMemberByRoomId(roomId);
            allow create: if canEditByRoomId(roomId)
              && request.resource.data.content is string
              && request.resource.data.content.size() <= 1048576;
            allow update, delete: if false;
          }
        }

        match /trash/{trashId} {
          allow get: if isMemberByRoomId(roomId);
          allow list: if isMemberByRoomId(roomId);
          allow create, update, delete: if canEditByRoomId(roomId);
        }
      }
    }

    // ----------------------------- Workspaces --------------------------------
    // Phase 2 canonical model. Membership is authoritative in
    // workspaces/{workspaceId}/members/{uid}. The legacy rooms tree remains
    // supported above for compatibility during migration.
    match /workspaces/{workspaceId} {
      function workspaceExists() {
        return exists(/databases/$(database)/documents/workspaces/$(workspaceId));
      }

      function workspaceData() {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
      }

      function isWorkspaceMember() {
        return signedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
      }

      function workspaceRole() {
        return isWorkspaceMember()
          ? get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role
          : null;
      }

      function isWorkspaceOwner() {
        return signedIn() && workspaceExists() && workspaceData().ownerId == request.auth.uid;
      }

      function canWorkspaceEdit() {
        return isWorkspaceMember() && workspaceRole() in ['owner', 'admin', 'editor'];
      }

      function canWorkspaceComment() {
        return isWorkspaceMember() && workspaceRole() in ['owner', 'admin', 'editor', 'commenter'];
      }

      allow get: if signedIn() && (resource.data.privacy == 'public' || isWorkspaceMember());
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 256
        && request.resource.data.privacy in ['public', 'private', 'invite-only']
        && request.resource.data.lifecycle == 'active';
      allow update: if isWorkspaceOwner()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'privacy', 'lifecycle', 'participantLimit', 'category', 'type', 'updatedAt'
        ]);
      allow delete: if false;

      match /members/{uid} {
        allow get: if isWorkspaceMember();
        allow list: if isWorkspaceMember();
        allow create: if isWorkspaceOwner()
          && uid == request.resource.data.uid
          && request.resource.data.role in ['owner','admin','editor','commenter','viewer','guest'];
        allow update: if isWorkspaceOwner()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role in ['owner','admin','editor','commenter','viewer','guest'];
        allow delete: if isWorkspaceOwner() && uid != request.auth.uid;
      }

      match /presence/{uid} {
        allow get, list: if isWorkspaceMember();
        allow create, update: if isWorkspaceMember()
          && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status in ['online','away','reconnecting','offline']
          && request.resource.data.lastActive is number;
        allow delete: if signedIn() && uid == request.auth.uid;
      }

      match /documents/{documentId} {
        allow get, list: if isWorkspaceMember();
        allow create: if canWorkspaceEdit()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 1048576
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;
        allow update: if canWorkspaceEdit()
          && request.resource.data.workspaceId == resource.data.workspaceId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 1048576
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if isWorkspaceOwner() || workspaceRole() == 'admin';
      }

      match /messages/{messageId} {
        allow get, list: if isWorkspaceMember();
        allow create: if canWorkspaceComment()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 20000;
        allow update: if canWorkspaceComment() && resource.data.senderUid == request.auth.uid;
        allow delete: if resource.data.senderUid == request.auth.uid || isWorkspaceOwner() || workspaceRole() == 'admin';
      }

      match /comments/{commentId} {
        allow get, list: if isWorkspaceMember();
        allow create: if canWorkspaceComment()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 20000;
        allow update: if canWorkspaceComment() && resource.data.authorUid == request.auth.uid;
        allow delete: if resource.data.authorUid == request.auth.uid || isWorkspaceOwner() || workspaceRole() == 'admin';
      }

      match /attachments/{attachmentId} {
        allow get, list: if isWorkspaceMember();
        allow create: if canWorkspaceEdit()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.uploadedBy == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 256
          && request.resource.data.url is string
          && request.resource.data.url.size() <= 4096
          && request.resource.data.sizeBytes is number
          && request.resource.data.sizeBytes <= 10485760;
        allow update: if canWorkspaceEdit() && resource.data.uploadedBy == request.auth.uid;
        allow delete: if resource.data.uploadedBy == request.auth.uid || isWorkspaceOwner() || workspaceRole() == 'admin';
      }

      match /projects/{projectId} {
        allow get, list: if isWorkspaceMember();
        allow create, update: if canWorkspaceEdit()
          && request.resource.data.workspaceId == workspaceId;
        allow delete: if isWorkspaceOwner() || workspaceRole() == 'admin';
      }

      match /history/{historyId} {
        allow get, list: if isWorkspaceMember();
        allow create: if canWorkspaceEdit()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 1048576;
        allow update, delete: if false;
      }

      match /audit/{auditId} {
        allow get, list: if isWorkspaceOwner() || workspaceRole() == 'admin';
        allow create: if (isWorkspaceOwner() || workspaceRole() == 'admin')
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.action is string;
        allow update, delete: if false;
      }
    }

    // ------------------------------- Users ----------------------------------
    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;

      match /workspaces/{workspaceId} {
        allow get: if signedIn() && request.auth.uid == userId;
        allow list: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.auth.uid == userId;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }
  }
}
